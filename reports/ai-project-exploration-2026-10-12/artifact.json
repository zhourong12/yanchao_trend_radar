      "id": "research_notes",
      "label": "AI 项目再探索研究说明",
      "path": "reports/ai-project-exploration-2026-10-12/source-notes.md",
      "query": {
        "engine": "mysql",
        "language": "sql",
        "description": "按固定权重计算 11 个候选方向的探索评分。",
        "sql": "WITH inputs AS (SELECT '雁巢用户购买信号' AS direction, 5 AS own_data, 4 AS business_value, 4 AS ai_necessity, 4 AS mvp_speed, 5 AS error_control UNION ALL SELECT '申报与敏感货 AI 预检', 5, 5, 5, 3, 3 UNION ALL SELECT '到仓前重量与运费预估', 5, 4, 3, 4, 4 UNION ALL SELECT 'LLM 热点→商品意图映射', 2, 3, 5, 5, 4 UNION ALL SELECT '口径守卫型经营分析 Agent', 4, 3, 4, 4, 3 UNION ALL SELECT '入库 QC 视觉比对', 3, 4, 5, 2, 4 UNION ALL SELECT '券与红包增益模型', 4, 4, 2, 3, 4 UNION ALL SELECT '“能不能寄”多语言问答 Agent', 3, 4, 4, 4, 2 UNION ALL SELECT '出海商品风险预检台（7/16）', 3, 3, 4, 3, 3 UNION ALL SELECT 'ProofPack 完工证据包（7/16）', 1, 3, 4, 4, 4 UNION ALL SELECT '雁巢需求实验室（7/16）', 2, 3, 1, 3, 4) SELECT direction, ROUND(own_data * 0.25 + business_value * 0.25 + ai_necessity * 0.15 + mvp_speed * 0.20 + error_control * 0.15, 2) AS score FROM inputs ORDER BY score DESC",
        "metric_definitions": {
          "score": "五项 1–5 分探索评估的加权平均：自有数据与结果标签 25%、可量化业务价值 25%、AI 必要性 15%、4 周 MVP 可行性 20%、错误可控 15%。"
        }
      }
    },
