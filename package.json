{
  "name": "yanchao-opportunity-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/server/index.ts --outDir dist-server",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:mysql": "tsx scripts/migrate-local-state-to-mysql.ts",
    "repair:collection-semantics": "tsx scripts/repair-collection-semantics.ts",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dailyhot-api": "^2.0.8",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.10.0",
    "google-trends-api": "^4.9.2",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.14.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
